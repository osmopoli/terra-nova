# Clé fournie par les organisateurs. Elle reste côté serveur, jamais dans le navigateur.
WEBCUP_API_KEY=
WEBCUP_API_URL=https://24h.webcup.fr/wp-json/webcup/v1/requests
# Intervalle de polling en secondes (15 à 30 recommandé)
POLL_INTERVAL_SECONDS=30
PORT=3000
# Base MySQL : soit DATABASE_URL (mysql://user:mdp@hôte:3306/base), soit les variables DB_* ci-dessous.
# En local, la base est créée automatiquement si l'utilisateur en a le droit ; les tables sont créées au démarrage.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=terranova
DB_NAME=terranova
# Base utilisée par npm test (vidée à chaque lancement)
DB_TEST_NAME=terranova_test
# Comptes créés au premier démarrage (changez les mots de passe)
ADMIN_EMAIL=admin@terranova.fr
ADMIN_PASSWORD=admin1234
AGENT_EMAIL=agent@terranova.fr
AGENT_PASSWORD=agent1234
